#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <500>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&ht sys_reset ESC  &kp N1  &kp N2   &kp  N3     &kp N4       &kp N5         &kp  N6     &kp N7     &kp N8     &kp N9   &kp N0        &ht sys_reset DASH
&kp TAB            &kp Q   &kp W    &kp  E      &kp R        &kp T          &kp  Y      &kp U      &kp I      &kp O    &kp P         &kp MINUS 
&kp LEFT_SHIFT     &kp A   &kp S    &kp  D      &kp F        &kp G          &kp  H      &kp J      &kp K      &kp L    &kp SEMI      &kp R_SHIFT
&kp BACKSPACE      &kp Z   &kp X    &kp  C      &kp V        &kp B          &kp  N      &kp M      &kp COMMA  &kp DOT  &kp QUESTION  &kp RBKT
                                    &mkp LCLK   &kp UP       &kp RIGHT      &mkp RCLK   &kp SPACE
                                                &lt L2 LEFT  &kp DOWN       &kp  ENTER
            >;
        };

        L2 {
            bindings = <
&ht sys_reset ESC  &kp N1  &kp N2   &kp  N3     &kp N4       &kp N5         &kp  N6     &kp N7     &kp N8     &kp N9   &kp N0        &ht sys_reset DASH
&kp TAB            &kp Q   &kp W    &kp  E      &kp R        &kp T          &kp  Y      &kp U      &kp I      &kp O    &kp P         &kp MINUS 
&kp LEFT_SHIFT     &kp A   &kp S    &kp  D      &kp F        &kp G          &kp  H      &kp J      &kp K      &kp L    &kp SEMI      &kp R_SHIFT
&kp BACKSPACE      &kp Z   &kp X    &kp  C      &kp V        &kp B          &kp  N      &kp M      &kp COMMA  &kp DOT  &kp QUESTION  &kp RBKT
                                    &mkp LCLK   &kp UP       &kp RIGHT      &mkp RCLK   &kp SPACE
                                                &none        &kp DOWN       &kp  ENTER
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &trans    &trans
            >;
        };
    };
};
