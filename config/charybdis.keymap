#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&ht {
    tapping-term-ms = <500>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&to 0>;
        };

        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&to 1>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings = <&to 2>, <&macro_wait_time 30>, <&to 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&ht &sys_reset ESC &kp N1  &kp N2   &kp  N3     &kp N4       &kp N5         &kp  N6     &kp N7     &kp N8     &kp N9   &kp N0        &ht &sys_reset MINUS
&kp TAB            &kp Q   &kp W    &kp  E      &kp R        &kp T          &kp  Y      &kp U      &kp I      &kp O    &kp P         &kp LBKT 
&kp LEFT_SHIFT     &kp A   &kp S    &kp  D      &kp F        &kp G          &kp  H      &kp J      &kp K      &kp L    &kp SEMI      &kp RIGHT_SHIFT
&kp BACKSPACE      &kp Z   &kp X    &kp  C      &kp V        &kp B          &kp  N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RBKT
                                    &mkp LCLK   &kp UP       &kp RIGHT      &mkp RCLK   &kp SPACE
                                                &lt L2 LEFT  &kp DOWN       &kp  ENTER
            >;
        };

        L2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans   &trans   &trans  &trans  &trans
                                &mo L3  &mo L4      &trans     &trans   &trans
                                        &trans      &mo L5     &trans
            >;
        };

        L3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
                                &trans  &trans      &trans   &trans   &trans
                                        &trans      &trans   &trans
            >;
        };

        L4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
                                &trans  &trans      &trans   &trans   &trans
                                        &trans      &trans   &trans
            >;
        };

        L5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans   &trans   &trans  &trans  &trans
                                &trans  &trans      &trans   &trans   &trans
                                        &trans      &trans   &trans
            >;
        };
    };
};
